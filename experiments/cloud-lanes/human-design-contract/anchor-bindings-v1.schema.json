{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allworld:experimental:human-design:anchor-bindings-v1",
  "title": "anchor-bindings-v1",
  "description": "Surface anchors evaluated after morphology, then skinned with the body. Triangle order is pinned by topologySha256. Structural checks cannot prove geometry, garment fit, ownership or clearance.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "frame": {
      "type": "string",
      "const": "body-metres-bind-y-up-z-forward"
    },
    "slot": {
      "type": "string",
      "enum": [
        "hair",
        "head",
        "ears",
        "face",
        "neck",
        "top",
        "bottom",
        "full",
        "wrist",
        "carry",
        "shoes"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "skeletonId": {
          "type": "string",
          "const": "allworld-body-23@1"
        },
        "bodySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "topologyId": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9._@-]+$"
        },
        "topologySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "anchorRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "triangleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "skeletonId",
        "bodySha256",
        "topologyId",
        "topologySha256",
        "anchorRevision",
        "triangleCount"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string",
            "enum": [
              "scalp.crown",
              "scalp.templeLeft",
              "scalp.templeRight",
              "ear.lobeLeft",
              "ear.lobeRight",
              "nose.bridge",
              "neck.collar",
              "shoulder.left",
              "shoulder.right",
              "waist.center",
              "wrist.left",
              "wrist.right",
              "foot.left",
              "foot.right"
            ]
          },
          "joint": {
            "type": "string",
            "enum": [
              "Head",
              "neck_01",
              "clavicle_l",
              "clavicle_r",
              "pelvis",
              "hand_l",
              "hand_r",
              "foot_l",
              "foot_r"
            ]
          },
          "triangle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "barycentric": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "normalOffsetMetres": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.03
          }
        },
        "required": [
          "anchorId",
          "joint",
          "triangle",
          "barycentric",
          "normalOffsetMetres"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "frame",
    "slot",
    "target",
    "bindings"
  ],
  "additionalProperties": false
}
