    "standard": {
      "minimumPlaces": 20,
      "minimumNeighbourhoodLabels": 5,
      "maximumEmptySlots": 0,
      "cityPlaceTags": [
        "city",
        "town"
      ],
      "capitalPlaceTags": [],
      "districtIslandPlaces": []
    },
    "microstate": {
